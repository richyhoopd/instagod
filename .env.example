# =====================================================================
#  .env.example — plantilla pública. Copia a .env y llena con TUS valores.
#  El .env real NUNCA se sube (está en .gitignore).
# =====================================================================

# ---------- IA / Generación de captions ----------
LLM_PROVIDER=deepseek                    # "deepseek" | "claude"
DEEPSEEK_API_KEY=sk-XXXXXXXX
# ANTHROPIC_API_KEY=sk-ant-XXXX          # solo si LLM_PROVIDER=claude

# ---------- Google Sheets (cola + panel) ----------
GOOGLE_SA_JSON=./secrets/google-sa.json
SHEET_ID=XXXXXXXX
# Comparte el Sheet (Editor) con el client_email de tu service account.

# ---------- Cloudinary (host público de imágenes) ----------
CLOUD_NAME=XXXXXXXX
CLOUDINARY_API_KEY=XXXXXXXX
CLOUDINARY_API_SECRET=XXXXXXXX

# ---------- Telegram (aprobación) ----------
TELEGRAM_BOT_TOKEN=123456789:AAH...
TELEGRAM_CHAT_ID=587461920

# ---------- Instagram / Meta ----------
IG_USER_ID=1784XXXXXXXXX
IG_ACCESS_TOKEN=XXXXXXXX
INSTAGRAM_APP_ID=XXXXXXXX
INSTAGRAM_APP_SECRET=XXXXXXXX
META_APP_ID=XXXXXXXX
IG_GRAPH_BASE=https://graph.instagram.com
IG_API_VERSION=v23.0

# ---------- Calendarización ----------
TIMEZONE=America/Mexico_City
POSTS_PER_DAY=1
POSTING_SLOTS=19:00

# ---------- Scraping de Instagram (Fase 2) ----------
# Cuenta SECUNDARIA (nunca la de @gdlscene): el scraping va contra ToS de Meta
# y hay riesgo de bloqueo. Ingesta puntual, no crawler 24/7.
IG_SCRAPER_USER=cuenta.secundaria
IG_SCRAPER_PASSWORD=XXXXXXXX
# navigator.userAgent EXACTO del navegador del que se importó el sessionid
# (IG responde "useragent mismatch" si no coincide).
IG_SCRAPER_UA=Mozilla/5.0 (...)
IG_INGEST_MAX_POSTS=12          # posts recientes por banda en cada sesión
IG_INGEST_DELAY_MIN=4           # segundos de pausa aleatoria entre requests
IG_INGEST_DELAY_MAX=10

# ---------- Spotify (Fase 4) — app de developer.spotify.com (dueño con Premium) ----------
SPOTIFY_CLIENT_ID=XXXXXXXX
SPOTIFY_CLIENT_SECRET=XXXXXXXX
SPOTIFY_RELEASE_DAYS=30

# ---------- Clasificación de fotos (Fase 3) ----------
# Ajusta mirando la columna "nitidez" en la GUI: sube si pasan borrosas.
CLASSIFY_NITIDEZ_MIN=60
CLASSIFY_OCR_MIN_CHARS=80

# ---------- Base de datos local (SQLite) ----------
# Fuente de verdad de bandas/fotos/eventos. Rutas relativas a la raíz del repo.
DB_PATH=./data/gdlscene.db
PHOTOS_DIR=./data/photos

# ---------- Crosspost X / Twitter (OAuth 1.0, developer.x.com — app Pay Per Use) ----------
X_API_KEY=XXXXXXXX                 # Consumer Key
X_API_SECRET=XXXXXXXX              # Consumer Key Secret
X_ACCESS_TOKEN=XXXXXXXX            # generado con permisos Read and write
X_ACCESS_SECRET=XXXXXXXX
CROSSPOST_X=1                      # 0 = apagar X sin tocar las demás redes

# ---------- Crosspost Facebook (Página; token permanente) ----------
FB_PAGE_ID=XXXXXXXX
FB_PAGE_ACCESS_TOKEN=XXXXXXXX      # de /{page_id}?fields=access_token con user token largo
CROSSPOST_FB=1

# ---------- Multi-cuenta (Fase A) ----------
# Credenciales por cuenta de escena: misma clave + __SLUG en mayúsculas.
# gdlscene usa las variables base de arriba (sin sufijo).
# IG_USER_ID__CDMXSCENE=
# IG_ACCESS_TOKEN__CDMXSCENE=
# IG_USER_ID__MTYSCENE=
# IG_ACCESS_TOKEN__MTYSCENE=
