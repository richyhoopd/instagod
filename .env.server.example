# ===== instagod en servidor — copia a .env y rellena =====
# Puedes partir de tu .env local (tiene las credenciales de gdlscene) y agregar este bloque.

ENV=prod
DB_PATH=/app/data/gdlscene.db
TIMEZONE=America/Mexico_City

# --- Portal ---
# Genera una: python -m api.bootstrap --nueva-master-key  (RESPÁLDALA aparte: sin ella se pierden los secretos cifrados)
INSTAGOD_MASTER_KEY=
# URL del front en Vercel (CORS + links de los magic links)
APP_URL=https://instagod-web-app-front.vercel.app
# URL pública de esta API (la que pones en Vercel como API_URL)
API_URL=https://api.midominio.com
# Dominio que sirve Caddy. Sin dominio deja ":80" y usa http://IP (sin TLS, sólo pruebas)
API_DOMAIN=:80
# Correo de los magic links (Resend). Si va vacío en ENV=prod no se pueden mandar links.
RESEND_API_KEY=
MAIL_FROM=instagod <no-reply@midominio.com>
SESSION_DAYS=30
WORKER_MAX_JOBS=2
PUBLISH_EVERY=300

# --- Globales existentes (LLM, Cloudinary, IG/Meta, Telegram, Spotify, X, FB...) ---
# Copia tal cual las de tu .env local. Ver .env.example para la lista completa.
